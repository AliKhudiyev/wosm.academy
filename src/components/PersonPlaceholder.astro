---
// Neutral placeholder portrait until a photo is supplied: a tiled glider
// pattern (docs/DESIGN.md §9). Decorative.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const cells: Array<[number, number]> = [
  [1, 0],
  [2, 1],
  [0, 2],
  [1, 2],
  [2, 2],
];
---

<svg class:list={['portrait', className]} viewBox="0 0 96 96" aria-hidden="true" focusable="false">
  <g fill="currentColor">
    {
      [0, 1, 2].flatMap((ty) =>
        [0, 1, 2].map((tx) => (
          <g transform={`translate(${8 + tx * 28} ${8 + ty * 28})`}>
            {cells.map(([x, y]) => (
              <rect x={x * 7} y={y * 7} width="6" height="6" />
            ))}
          </g>
        )),
      )
    }
  </g>
</svg>
