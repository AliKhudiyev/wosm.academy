---
import '@fontsource-variable/source-serif-4/opsz.css';
// Italic is only used in running text, so the smaller weight-axis build is enough.
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../config/site';
import { pageTitle } from '../lib/format';

export interface Props {
  /** Page name; rendered as "Page — WoSM Academy". Omit on the home page. */
  title?: string;
  /** Meta description, ≤ 155 characters. */
  description: string;
  /** Social card image (absolute path). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Background simulation for this page ("life" by default, "none" to disable). */
  sim?: string;
}

const {
  title,
  description,
  image = '/og-default.png',
  imageAlt = 'WoSM Academy — Wisdom of Starving Minds',
  type = 'website',
  publishedTime,
  noindex = false,
  jsonLd,
  sim,
} = Astro.props;

const fullTitle = pageTitle(title);
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const imageUrl = new URL(image, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="en-GB" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Runs before first paint: mark JS as available and apply a saved theme
      // choice (otherwise CSS follows prefers-color-scheme). No flash.
      (function () {
        var root = document.documentElement;
        root.classList.remove('no-js');
        root.classList.add('js');
        try {
          var theme = localStorage.getItem('wosm:theme');
          if (theme === 'light' || theme === 'dark') root.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="WoSM Academy Journal" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body data-sim={sim}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { init } from '../lib/simulation';
      init();
    </script>
  </body>
</html>
